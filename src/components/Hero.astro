---
import { HERO } from '../data/site.js';
// Hero: sage balloon background (Untitled-design-11.png). The giant BALLOONS LANE
// title is the hero video clipped by the original text mask
// (hero-video-mask.png — its alpha channel holds the letter shapes), exactly as
// the live homepage renders it. If the video cannot play, the poster frame
// still fills the letters.
---
<section class="hero" aria-label="Balloons Lane balloon delivery">
  <img
    class="hero-bg"
    src="/images/hero/hero-bg.avif"
    alt=""
    width="1600"
    height="900"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-inner wrap">
    <div class="hero-title" role="img" aria-label={HERO.title}>
      <video
        class="hero-title-video"
        src={HERO.videoSrc}
        poster="/images/hero/hero-balloons-poster.avif"
        autoplay
        muted
        loop
        playsinline
        aria-hidden="true"
      ></video>
    </div>
    <h2 class="hero-tagline">{HERO.tagline}</h2>
    <a class="btn-pill hero-cta" href={HERO.ctaHref}>{HERO.ctaLabel}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--sage-light);
    overflow: hidden;
    margin-top: -90px;
    padding-top: 150px;
    padding-bottom: 4.5rem;
    min-height: 70vh;
    display: flex; align-items: center;
  }
  .hero-bg {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
  }
  .hero-inner { position: relative; text-align: center; width: 100%; }
  .hero-title {
    position: relative;
    width: min(1500px, 96%);
    aspect-ratio: 1804 / 352;
    margin: 0 auto;
    background: url('/images/hero/hero-balloons-poster.avif') center / cover no-repeat;
    -webkit-mask-image: url('/images/hero/hero-video-mask.png');
    -webkit-mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-image: url('/images/hero/hero-video-mask.png');
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
  }
  .hero-title-video {
    position: absolute; inset: 0;
    display: block;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .hero-tagline {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(1.05rem, 2.1vw, 1.7rem);
    letter-spacing: 0.01em;
    max-width: 1150px;
    margin: 2.4rem auto 0;
    color: var(--ink-soft);
  }
  .hero-cta {
    background: #cccccc; color: var(--ink);
    font-size: 1.2rem; box-shadow: var(--shadow-card);
    margin-top: 2.6rem;
  }
  .hero-cta:hover { background: #bbbbbb; }
  @media (max-width: 767px) {
    .hero { padding-top: 130px; min-height: 60vh; }
    .hero-title { width: 100%; }
    .hero-tagline { margin-top: 1.6rem; }
    .hero-cta { margin-top: 1.8rem; }
  }
</style>
