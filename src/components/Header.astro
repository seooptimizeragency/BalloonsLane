---
import Icon from './Icon.astro';
import { NAV_LINKS, CONTACT, SOCIAL_LINKS, HEADER_EXTRA } from '../data/site.js';

const rail = SOCIAL_LINKS.map((s) => s.label === 'Twitter' ? { ...s, icon: 'x' } : { ...s, icon: s.label.toLowerCase() });
---
<!-- Fixed left social rail -->
<aside class="social-rail" aria-label="Social media links">
  <ul>
    {rail.map((s) => (
      <li>
        <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
          <Icon name={s.icon} size={18} />
        </a>
      </li>
    ))}
  </ul>
  <a class="off-tab" href="#catalog" aria-label="Get 10 percent off">GET 10% OFF</a>
</aside>

<!-- Floating pill header -->
<header class="site-header">
  <div class="header-pill">
    <a class="brand" href="https://balloonslane.com/" aria-label="Balloons Lane — home">
      <img
        src="/images/logo/balloons-lane-logo.png"
        alt="Balloons Lane logo"
        width="190"
        height="64"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      <ul>
        {NAV_LINKS.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a class="icon-btn wa" href={CONTACT.whatsapp} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
        <Icon name="whatsapp" size={22} />
      </a>
      <a class="phone-pill" href={CONTACT.phoneHref} aria-label={'Call ' + CONTACT.phoneDisplay}>
        <Icon name="phone" size={16} />
        <span>7184270968</span>
      </a>
      <a class="quote-pill" href="https://balloonslane.com/order-inquiry/">Get A Quate</a>
      <a class="shop-pill" href={HEADER_EXTRA.shopNow.href}>{HEADER_EXTRA.shopNow.label}</a>
      <button class="icon-btn" type="button" data-search-open aria-label="Search">
        <Icon name="search" size={20} />
      </button>
      <a class="icon-btn cart" href={HEADER_EXTRA.cartHref} aria-label="Shopping cart">
        <Icon name="cart" size={22} />
        <span class="cart-text">{HEADER_EXTRA.cartLabel}</span>
        <span class="cart-badge" aria-hidden="true">0</span>
      </a>
      <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation">
    <ul>
      {NAV_LINKS.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
      <li><a href="https://balloonslane.com/order-inquiry/">Get A Quate</a></li>
      <li><a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a></li>
    </ul>
  </nav>
</header>

<!-- Full-screen search modal -->
<div id="search-modal" class="search-modal" aria-hidden="true" role="dialog" aria-label="Search">
  <div class="search-box">
    <button class="icon-btn search-close" type="button" data-search-close aria-label="Close search">
      <Icon name="close" size={24} />
    </button>
    <form role="search" method="get" action="https://balloonslane.com/">
      <input type="search" name="s" placeholder="Search..." aria-label="Search products" />
      <button class="btn-pill btn-dark" type="submit">Search</button>
    </form>
  </div>
</div>

<style>
  .site-header {
    position: sticky; top: 12px; z-index: 1000;
    display: flex; justify-content: center;
    padding: 0 16px;
    pointer-events: none;
  }
  .header-pill {
    pointer-events: auto;
    width: min(1240px, 100%);
    background: var(--white);
    border-radius: var(--radius-pill);
    box-shadow: 0 12px 34px rgba(20, 20, 20, 0.16);
    display: flex; align-items: center; gap: 1rem;
    padding: 0.55rem 1.1rem;
  }
  .brand img { height: 52px; width: auto; }
  .main-nav ul {
    display: flex; gap: 1.6rem; list-style: none; margin: 0; padding: 0;
  }
  .main-nav a {
    text-decoration: none; font-family: var(--font-accent);
    font-weight: 700; font-size: 1.02rem; color: var(--ink);
  }
  .main-nav a:hover { color: var(--orange-deep); }
  .header-actions { margin-left: auto; display: flex; align-items: center; gap: 0.55rem; }
  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 42px; height: 42px; border-radius: 50%;
    border: 0; background: transparent; cursor: pointer; color: var(--ink);
    position: relative;
  }
  .icon-btn:hover { background: var(--sage-pale); }
  .icon-btn.wa { color: #1faa55; }
  .phone-pill {
    display: inline-flex; align-items: center; gap: 0.45rem;
    background: var(--sage-light); color: var(--ink);
    font-family: var(--font-accent); font-weight: 800; font-size: 0.95rem;
    padding: 0.6em 1.1em; border-radius: var(--radius-pill); text-decoration: none;
    white-space: nowrap;
  }
  .quote-pill {
    background: #ff0000; color: #fff;
    font-family: var(--font-accent); font-weight: 800; font-size: 0.95rem;
    padding: 0.6em 1.25em; border-radius: var(--radius-pill); text-decoration: none;
    white-space: nowrap;
  }
  .quote-pill:hover { background: #cc0000; }
  .shop-pill {
    background: var(--sage); color: var(--ink);
    font-family: var(--font-accent); font-weight: 800; font-size: 0.95rem;
    padding: 0.6em 1.25em; border-radius: var(--radius-pill); text-decoration: none;
    white-space: nowrap;
  }
  .shop-pill:hover { background: var(--sage-deep); }
  .cart-text {
    font-family: var(--font-accent); font-weight: 700; font-size: 0.85rem;
    margin-left: 0.35rem; white-space: nowrap;
  }
  .icon-btn.cart { width: auto; border-radius: 999px; padding: 0 0.8rem; }
  .cart-badge {
    position: absolute; top: 2px; right: 0;
    background: var(--red); color: #fff;
    font-size: 0.68rem; font-weight: 800; font-family: var(--font-accent);
    min-width: 19px; height: 19px; border-radius: 999px;
    display: flex; align-items: center; justify-content: center; padding: 0 4px;
  }
  .menu-btn { display: none; }

  .mobile-nav {
    display: none;
    pointer-events: auto;
    position: absolute; top: calc(100% + 8px); left: 16px; right: 16px;
    background: var(--white); border-radius: var(--radius-md);
    box-shadow: var(--shadow-card); padding: 0.6rem;
  }
  .mobile-nav.open { display: block; }
  .mobile-nav ul { list-style: none; margin: 0; padding: 0; }
  .mobile-nav a {
    display: block; padding: 0.75rem 1rem; border-radius: 12px;
    text-decoration: none; font-family: var(--font-accent); font-weight: 700;
  }
  .mobile-nav a:hover { background: var(--sage-pale); }

  /* Social rail */
  .social-rail {
    position: fixed; left: 0; top: 50%; transform: translateY(-50%);
    z-index: 900; display: flex; flex-direction: column; align-items: center;
  }
  .social-rail ul {
    list-style: none; margin: 0; padding: 0.5rem 0;
    background: var(--white); border-radius: 0 14px 14px 0;
    box-shadow: var(--shadow-soft); display: flex; flex-direction: column;
  }
  .social-rail a {
    display: flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; color: var(--ink);
  }
  .social-rail a:hover { color: var(--orange-deep); }
  .off-tab {
    writing-mode: vertical-rl; text-orientation: mixed;
    background: var(--red); color: #fff;
    font-family: var(--font-accent); font-weight: 800; font-size: 0.78rem;
    letter-spacing: 0.12em; text-decoration: none;
    padding: 1rem 0.45rem; border-radius: 0 10px 10px 0; margin-top: 6px;
  }

  /* Search modal */
  .search-modal {
    position: fixed; inset: 0; z-index: 1500;
    background: rgba(15, 15, 15, 0.72);
    display: none; align-items: center; justify-content: center; padding: 1.5rem;
  }
  .search-modal.open { display: flex; }
  .search-box {
    position: relative; width: min(560px, 100%);
    background: var(--white); border-radius: var(--radius-lg);
    padding: 3rem 2rem 2rem; box-shadow: var(--shadow-card);
  }
  .search-close { position: absolute; top: 0.7rem; right: 0.7rem; }
  .search-box form { display: flex; gap: 0.6rem; }
  .search-box input[type='search'] {
    flex: 1; font-size: 1.05rem; padding: 0.8em 1.1em;
    border: 2px solid var(--gray-line); border-radius: var(--radius-pill);
    font-family: var(--font-body);
  }

  @media (max-width: 1024px) {
    .main-nav { display: none; }
    .menu-btn { display: inline-flex; }
    .phone-pill span { display: none; }
    .phone-pill { padding: 0.6em 0.75em; }
  }
  @media (max-width: 560px) {
    .quote-pill { display: none; }
    .social-rail { display: none; }
    .site-header { top: 8px; }
  }
</style>
