---
import { FAQS } from '../data/site.js';
---
<section class="faq" aria-labelledby="faq-heading">
  <div class="wrap">
    <h2 class="banner-title" id="faq-heading">F.A.Q.</h2>
    <div class="faq-card" data-faq>
      {FAQS.map((f) => (
        <details class="faq-item">
          <summary><span class="faq-q">{f.q}</span><span class="faq-icon" aria-hidden="true">▸</span></summary>
          <div class="faq-a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    text-align: center; padding: 3rem 0;
    background: url('/images/decorations/faq-section-bg.avif') center / cover no-repeat;
  }
  .faq-card {
    margin-top: 1.8rem; background: var(--pink);
    border-radius: var(--radius-lg); padding: clamp(1.2rem, 3vw, 2.2rem);
    box-shadow: 22px 18px 15px 2px rgba(0, 0, 0, 0.18);
    text-align: left; display: grid; gap: 1rem;
  }
  .faq-item {
    background: #fff; border-radius: 14px;
    box-shadow: 0 6px 16px rgba(0,0,0,0.08);
  }
  .faq-item summary {
    list-style: none; cursor: pointer;
    display: flex; align-items: center; gap: 0.7rem;
    padding: 1.05rem 1.3rem;
    font-family: var(--font-accent); font-weight: 700; font-size: 1.02rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-icon { color: var(--ink); transition: transform 0.2s ease; font-size: 1.2rem; }
  .faq-item[open] .faq-icon { transform: rotate(90deg); }
  .faq-a { padding: 0 1.3rem 1.2rem; color: var(--ink-soft); }
  .faq-a p { margin: 0; }
</style>
