---
import { INTRO, HERO } from '../data/site.js';
---
<section class="intro" aria-label="Top rated balloon delivery New York City">
  <img
    class="intro-bg"
    src="/images/hero/banquet-hall-banner.avif"
    alt="Banquet hall decorated with balloon centerpieces"
    width="1600"
    height="620"
    loading="lazy"
  />
  <div class="intro-inner wrap" id="content">
    <h1>{INTRO.h1}</h1>
    <h2 class="intro-sub">{INTRO.sub}</h2>
    <p><a class="btn-pill intro-cta" href={HERO.ctaHref}>Order Inquiry</a></p>
  </div>
</section>

<style>
  .intro { position: relative; overflow: hidden; text-align: center; }
  .intro-bg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  .intro::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(10,10,10,0.45), rgba(10,10,10,0.62));
  }
  .intro-inner { position: relative; z-index: 1; padding: 5.5rem 1rem; color: #fff; }
  .intro h1 {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.6vw, 3.2rem);
    text-transform: uppercase; letter-spacing: 0.02em;
    margin: 0 0 0.7rem; color: #fff;
    text-shadow: 0 3px 18px rgba(0,0,0,0.5);
  }
  .intro-sub {
    font-family: var(--font-accent); font-weight: 600;
    font-size: clamp(1.05rem, 2.4vw, 1.4rem);
    max-width: 1000px; margin: 0 auto 1.8rem; color: #fff;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }
  .intro-cta { background: #cccccc; color: var(--ink); font-size: 1.15rem; box-shadow: var(--shadow-card); }
  .intro-cta:hover { background: #bbbbbb; }
  @media (max-width: 767px) { .intro-inner { padding: 3.8rem 1rem; } }
</style>
