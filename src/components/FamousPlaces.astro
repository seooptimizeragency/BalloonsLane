---
import { FAMOUS_PLACES, DESIGNS_LINKS } from '../data/site.js';
const slugs = ['brooklyn-bridge', 'new-jersey-skyline', 'staten-island-ferry', 'times-square'];
---
<section class="places" aria-label="Famous places we deliver around">
  <div class="wrap">
    <h2 class="display places-title">The Famous Places We Deliver Around</h2>
    <div class="places-grid">
      {FAMOUS_PLACES.map((p, i) => (
        <a class="place-card" href={p.href} target="_blank" rel="noopener">
          <img
            src={`/images/galleries/${slugs[i]}.avif`}
            alt={p.alt}
            width="600"
            height="420"
            loading="lazy"
          />
          <span class="place-name">{p.name}</span>
        </a>
      ))}
    </div>
    <div class="designs-row">
      <span class="designs-cta">Click here for more designs</span>
      <nav aria-label="More designs">
        <ul>
          {DESIGNS_LINKS.map((d) => (
            <li><a href={d.href}>{d.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</section>

<style>
  .places { padding: 3rem 0; }
  .places-title { text-align: center; font-size: clamp(1.9rem, 4.6vw, 3.2rem); margin-bottom: 2rem; }
  .places-grid {
    display: grid; gap: 1.4rem;
    grid-template-columns: repeat(4, 1fr);
  }
  .place-card {
    position: relative; display: block; border-radius: 22px; overflow: hidden;
    box-shadow: var(--shadow-card); text-decoration: none; aspect-ratio: 10 / 7;
  }
  .place-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease; }
  .place-card:hover img { transform: scale(1.05); }
  .place-name {
    position: absolute; left: 12px; bottom: 12px;
    background: rgba(255,255,255,0.94); color: var(--ink);
    font-family: var(--font-accent); font-weight: 800; font-size: 0.95rem;
    padding: 0.4em 1em; border-radius: 999px;
  }
  .designs-row {
    margin-top: 2.6rem; text-align: center;
    display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: center;
  }
  .designs-cta { font-family: var(--font-display); font-size: 1.3rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .designs-row ul { display: flex; flex-wrap: wrap; gap: 0.7rem; list-style: none; margin: 0; padding: 0; }
  .designs-row ul a {
    display: inline-block; background: var(--peach); border-radius: 999px;
    padding: 0.5em 1.3em; font-family: var(--font-accent); font-weight: 700;
    text-decoration: none; box-shadow: var(--shadow-soft);
  }
  @media (max-width: 900px) { .places-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
