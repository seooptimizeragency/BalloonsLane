---
// Magazine-cover style category cards with peach pill labels overlapping below.
interface Card { name: string; href: string; image: string; alt?: string }
interface Props {
  id?: string;
  eyebrow: string;
  title?: string;
  cards: Card[];
  comingSoon?: boolean;
}
const { id, eyebrow, title, cards, comingSoon = false } = Astro.props;
---
<section class="cat-section" id={id} aria-label={eyebrow}>
  <div class="wrap">
    <h2 class="display cat-title"><span class="eyebrow">{eyebrow}</span>{title && <span class="sub">{title}</span>}</h2>
    <div class="card-grid">
      {cards.map((c) => (
        <article class="mag-card">
          <a class="mag-cover" href={c.href} aria-label={c.name}>
            <img src={c.image} alt={c.alt || c.name} width="600" height="800" loading="lazy" />
            <span class="mag-kicker" aria-hidden="true">BALLOONS LANE</span>
            <span class="mag-no" aria-hidden="true">1050</span>
          </a>
          <a class="card-label mag-label" href={c.href}>{c.name}</a>
        </article>
      ))}
      {comingSoon && (
        <article class="mag-card soon" aria-label="Coming soon">
          <div class="mag-cover soon-cover">
            <img src="/images/galleries/balloon-garland.avif" alt="Balloon garland — coming soon" width="450" height="750" loading="lazy" />
          </div>
          <span class="card-label mag-label">Coming Soon</span>
        </article>
      )}
    </div>
  </div>
</section>

<style>
  .cat-section {
    padding: 3.2rem 0;
    background: url('/images/decorations/section-bg-pattern.avif') center / cover no-repeat;
  }
  .cat-title { text-align: center; font-size: clamp(2.2rem, 5.4vw, 3.8rem); margin-bottom: 2.2rem; }
  .eyebrow { display: block; }
  .cat-title .sub { display: block; font-size: 0.5em; font-family: var(--font-accent); font-weight: 800; letter-spacing: 0.14em; margin-top: 0.4em; }
  .card-grid {
    display: grid; gap: 2.4rem 1.4rem;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }
  .mag-card { text-align: center; }
  .mag-cover {
    position: relative; display: block; overflow: hidden;
    border-radius: 20px; box-shadow: var(--shadow-card);
    aspect-ratio: 3 / 4; background: var(--sage-pale);
    text-decoration: none;
  }
  .mag-cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease; }
  .mag-cover:hover img { transform: scale(1.045); }
  .mag-kicker {
    position: absolute; top: 10px; left: 12px; right: 12px;
    font-family: var(--font-display); font-size: 0.8rem; letter-spacing: 0.18em;
    color: #fff; text-shadow: 0 1px 6px rgba(0,0,0,0.55); text-align: left;
  }
  .mag-no {
    position: absolute; bottom: 10px; right: 12px;
    font-family: var(--font-accent); font-weight: 800; font-size: 0.75rem;
    color: #fff; background: rgba(0,0,0,0.45);
    padding: 0.25em 0.7em; border-radius: 999px;
  }
  .mag-label { margin-top: -1.15rem; position: relative; z-index: 1; }
  @media (max-width: 560px) {
    .card-grid { grid-template-columns: repeat(2, 1fr); gap: 2rem 0.9rem; }
  }
</style>
