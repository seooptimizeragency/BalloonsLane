---
import { VIDEOS, VIDEO_GALLERY_URL } from '../data/site.js';
---
<section class="video-section" aria-label="Party balloons delivery videos">
  <div class="wrap">
    <h2 class="banner-title">Party Balloons Delivery Video <span class="vid-sub">(Please like share and subscribe)</span></h2>
    <div class="video-grid">
      {VIDEOS.map((v, i) => (
        <div
          class="yt-box"
          data-yt={v.id}
          data-yt-title={v.title}
          role="button"
          tabindex="0"
          aria-label={'Play video: ' + v.title}
          onkeydown={`if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}`}
        >
          <img
            src={`/images/videos/video-${v.id}.avif`}
            alt={v.title + ' thumbnail'}
            width="640"
            height="360"
            loading="lazy"
          />
          <span class="play" aria-hidden="true">▶</span>
        </div>
      ))}
    </div>
    <p class="gallery-link"><a href={VIDEO_GALLERY_URL} target="_blank" rel="noopener">Video Gallery</a></p>
  </div>
</section>

<style>
  .video-section { text-align: center; padding: 3rem 0; }
  .vid-sub { display: block; font-size: 0.55em; font-family: var(--font-accent); font-weight: 700; letter-spacing: 0.06em; margin-top: 0.3em; }
  .video-grid {
    margin-top: 2rem; display: grid; gap: 1.6rem;
    grid-template-columns: repeat(2, 1fr);
  }
  .yt-box {
    position: relative; border-radius: 26px; overflow: hidden;
    box-shadow: var(--shadow-card); cursor: pointer;
    aspect-ratio: 16 / 9; background: #111;
  }
  .yt-box img { width: 100%; height: 100%; object-fit: cover; }
  .play {
    position: absolute; inset: 0; margin: auto;
    width: 76px; height: 76px; border-radius: 50%;
    background: rgba(225, 29, 46, 0.92); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.7rem; padding-left: 6px;
  }
  .yt-box:hover .play, .yt-box:focus-visible .play { transform: scale(1.08); }
  .play { transition: transform 0.2s ease; }
  .gallery-link { margin-top: 1.6rem; font-family: var(--font-accent); font-weight: 800; font-size: 1.15rem; }
  .gallery-link a { color: var(--orange-deep); }
  @media (max-width: 767px) { .video-grid { grid-template-columns: 1fr; } }
</style>
